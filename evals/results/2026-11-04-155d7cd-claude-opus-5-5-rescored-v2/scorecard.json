          {
            "level": "must",
            "name": "no fresh VMs",
            "ok": true
          }
        ],
        "calls": [
          {
            "tool": "vm_bash",
            "denied": true,
            "args": {
              "vm": "demo"
            }
          },
          {
            "tool": "vm_info",
            "args": {
              "action": "list"
            }
          },
          {
            "tool": "vm_manage",
            "denied": true,
            "args": {
              "action": "fork",
              "vm": "demo",
              "to": [
