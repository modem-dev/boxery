{
  "name": "boxery-vm",
  "version": "0.10.1",
  "description": "Easiest way to give your coding agents VMs; MCP server + pi extension give agents vm_* tools",
  "keywords": [
    "pi-package",
    "mcp",
    "mcp-server",
    "vm",
    "computer-use",
    "coding-agent",
    "libvirt",
    "lima",
    "kvm"
  ],
  "homepage": "https://github.com/modem-dev/boxery#readme",
  "bugs": {
    "url": "https://github.com/modem-dev/boxery/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modem-dev/boxery.git"
  },
  "author": "Ben Vinegar",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "bin": {
    "boxery": "controller/boxery",
    "boxery-host": "host/boxery-host",
    "boxery-mcp": "mcp/boxery-mcp.mjs",
    "boxery-vm": "mcp/boxery-mcp.mjs"
  },
  "files": [
    "controller/",
    "core/",
    "extension/",
    "backends/",
    "guests/",
    "host/",
    "image/",
    "mcp/boxery-mcp.mjs",
    "mcp/desktop-view.html",
    "proxy/",
    "docs/*.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:shell": "bash test/shell/run.sh",
    "lint": "bash test/lint.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p test && tsc -p evals",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/modem-dev/boxery/master/docs/computer-use.png"
  }
}
