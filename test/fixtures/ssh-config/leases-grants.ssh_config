# generated by boxery setup — VMs are reached as <name>.boxery through the host
Host pool-1.boxery
  IdentityFile "@BASE@/p/leases/l-0123456789abcdef0123456789abcdef.key"
  IdentitiesOnly yes
Host pool-2.boxery
  IdentityFile "@BASE@/p/leases/l-fedcba9876543210fedcba9876543210.key"
  IdentitiesOnly yes
Host demo.boxery
  ForwardAgent yes
Host w2.boxery
  ForwardAgent yes
Host *.boxery
  ForwardAgent no
  User agent
  ProxyCommand "@HOME@/.local/bin/boxery-host" connect %h %p
  KnownHostsCommand /bin/sh -c "exec \"@HOME@/.local/bin/boxery-host\" known-hosts \"$1\"" sh %H
  StrictHostKeyChecking yes
  UserKnownHostsFile none
  GlobalKnownHostsFile none
  CheckHostIP no
  UpdateHostKeys no
  LogLevel ERROR
  ConnectTimeout 15
  ServerAliveInterval 10
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath "@BASE@/p/cm-"%h
  ControlPersist 10m
  IdentityFile "/k/id"
