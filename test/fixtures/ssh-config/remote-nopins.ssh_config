# generated by boxery setup — VMs are reached as <name>.boxery through the host
Host *.boxery
  ForwardAgent no
  User agent
  ProxyCommand ssh -o LogLevel=ERROR -- "ben@hornet.example" "exec \"\$HOME\"/'bin/boxery host'" connect %h %p
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
  ConnectTimeout 15
  ServerAliveInterval 10
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath "@BASE@/p/cm-"%h
  ControlPersist 10m
