# generated by boxery setup — VMs are reached as <name>.boxery through the host
Host *.boxery
  ForwardAgent no
  User agent
  ProxyCommand ssh -o LogLevel=ERROR -- "u%%x@h" "exec \"\$HOME\"/'it'\\''s \"q\" \$x \`y\` \\z%%p' --profile p2" connect %h %p
  KnownHostsCommand /bin/sh -c "exec ssh -o LogLevel=ERROR -- \"u%%x@h\" \"exec \\\"\\$HOME\\\"/'it'\\\\''s \\\"q\\\" \\$x \\`y\\` \\\\z%%p' --profile p2\" known-hosts \"$1\"" sh %H
  StrictHostKeyChecking yes
  UserKnownHostsFile none
  GlobalKnownHostsFile none
  CheckHostIP no
  UpdateHostKeys no
  LogLevel ERROR
  ConnectTimeout 15
  ServerAliveInterval 10
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath "@BASE@/dir with space%%/cm-"%h
  ControlPersist 10m
  IdentityFile "/k/it's %%h \"q\""
