# generated by boxery setup — VMs are reached as <name>.boxery through the host
Host *.boxery
  ForwardAgent no
  User agent
  ProxyCommand ssh -o LogLevel=ERROR -- "h" "exec '/usr/bin/boxery-host'" connect %h %p
  KnownHostsCommand /bin/sh -c "exec ssh -o LogLevel=ERROR -- \"h\" \"exec '/usr/bin/boxery-host'\" known-hosts \"$1\"" sh %H
  StrictHostKeyChecking yes
  UserKnownHostsFile none
  GlobalKnownHostsFile none
  CheckHostIP no
  UpdateHostKeys no
  LogLevel ERROR
  ConnectTimeout 15
  ServerAliveInterval 10
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath "@BASE@/p/cm-"%h
  ControlPersist 10m
