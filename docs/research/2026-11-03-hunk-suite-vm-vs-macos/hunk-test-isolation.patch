index 00000000..50db7eb0
--- /dev/null
+++ b/test/helpers/user-dirs-preload.ts
@@ -0,0 +1,23 @@
+import { afterAll } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+/**
+ * Points every `bun test` process at empty user config and state dirs before any test loads.
+ *
+ * Without this, tests and the hunk processes they spawn read the developer's real
+ * `~/.config/hunk` (global config, installed extensions) and `~/.local/state/hunk`, so a
+ * locally installed extension or preference changes results. hunk resolves XDG_CONFIG_HOME
+ * and XDG_STATE_HOME ahead of HOME on every OS, and spawned children inherit them. Tests that
+ * need their own config still assign a fresh dir per file or case and restore this baseline.
+ */
+const isolatedRoot = mkdtempSync(join(tmpdir(), "hunk-test-user-dirs-"));
+
+process.env.XDG_CONFIG_HOME = join(isolatedRoot, "config");
+process.env.XDG_STATE_HOME = join(isolatedRoot, "state");
+
+// Bun runs hooks registered in a preload once around the whole run; it never emits beforeExit.
+afterAll(() => {
+  rmSync(isolatedRoot, { recursive: true, force: true });
+});
