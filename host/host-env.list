# Settings `boxery-host init` persists in $BOXERY_CONF/host.env, which later commands read back.
# One name per line. Read by host/backend.sh (Bash, no Node: connect must start fast) and host/config.mjs.
# Explicit environment variables win over the file; an empty one counts as unset.
BOXERY_BACKEND
BOXERY_PROXY_PORT
BOXERY_PROXY_UNIT
BOXERY_POOL
BOXERY_POOL_DIR
BOXERY_BASE_VOL
BOXERY_DOMAIN_PREFIX
BOXERY_NET
BOXERY_NET_ISOLATION
LIBVIRT_DEFAULT_URI
LIMA_HOME
BOXERY_LIMA_PREFIX
BOXERY_LIMA_GATEWAY
BOXERY_LIMA_VMTYPE
BOXERY_LIMA_ARCH
BOXERY_CH_DIR
BOXERY_CH_NET
BOXERY_CH_DNS
BOXERY_CH_FIRMWARE
BOXERY_CH_SUDO
BOXERY_EXE_DIR
BOXERY_EXE_PREFIX
BOXERY_EXE_KEY
BOXERY_EXE_PORT_BASE
BOXERY_EXE_GUEST_PORT
BOXERY_EXE_EGRESS
BOXERY_EXE_POOL
BOXERY_EXE_ALLOW_INTEGRATIONS
BOXERY_EXE_MAX_CPUS
BOXERY_EXE_MAX_MEM
BOXERY_BOAT_DIR
BOXERY_BOAT_PREFIX
BOXERY_BOAT_API
BOXERY_BOAT_ORG
BOXERY_BOAT_PORT_BASE
BOXERY_BOAT_GUEST_PORT
BOXERY_BOAT_MAX_TYPE
BOXERY_BOAT_TTL
BOXERY_STALE_DAYS
BOXERY_OPENSHELL_GATEWAY
BOXERY_OPENSHELL_WORKSPACE
BOXERY_OPENSHELL_PREFIX
BOXERY_OPENSHELL_IMAGE
BOXERY_OPENSHELL_POLICY
BOXERY_OPENSHELL_PROVIDERS
