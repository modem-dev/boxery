#!/usr/bin/env bash
# boxery-host: manage Ubuntu desktop VMs for coding agents.
# Runs on the VM host (Linux with libvirt, macOS/Linux with Lima, or anywhere with ssh for exe.dev/boat.dev). The
# controller (`boxery`) calls it over ssh, or directly when the controller runs on the host itself (HOST=local).
# Entry point only: commands run in Node (host/boxery-host.mjs). `connect` is the ssh ProxyCommand for
# every VM connection, so it stays in Bash (host/backend.sh) and never pays Node's startup.
# VM-platform specifics live in host/backends/<backend>.sh (see host/backends/README.md).
set -eu

resolve() { local p=$1; while [ -L "$p" ]; do local t; t=$(readlink "$p"); case $t in /*) p=$t ;; *) p=$(dirname "$p")/$t ;; esac; done; echo "$p"; }  # macOS has no readlink -f
# -P: the package directory itself can be a symlink (npm install -g CHECKOUT), and modules that check
# whether they are the entry point compare their real path (boxery-upgrade.mjs).
ROOT=$(cd -P "$(dirname "$(resolve "$0")")/.." && pwd)

# --profile NAME: a second profile on this host (its own state, backend, proxy port and services) in
# ~/.config/boxery-NAME. The controller passes it as an argument, so it needs no wrapper or env var.
if [ "${1:-}" = --profile ]; then
	p=${2:-}
	[[ $p =~ ^[a-z][a-z0-9-]{0,30}$ ]] || { echo "boxery-host: invalid profile name '$p' (use [a-z][a-z0-9-]*)" >&2; exit 1; }
	pconf=$HOME/.config/boxery-$p
	if [ -n "${BOXERY_CONF:-}" ] && [ "$BOXERY_CONF" != "$pconf" ]; then echo "boxery-host: --profile $p conflicts with BOXERY_CONF=$BOXERY_CONF" >&2; exit 1; fi
	if [ "${3:-}" != init ] && [ ! -f "$pconf/host.env" ]; then
		echo "boxery-host: no profile '$p' on this host (create it: boxery-host --profile $p init --backend NAME)" >&2; exit 1
	fi
	export BOXERY_CONF=$pconf BOXERY_PROFILE=$p
	shift 2
fi

if [ "${1:-}" = connect ]; then shift; exec "$ROOT/host/backend.sh" __connect "$@"; fi

# The node `init` recorded: nvm/fnm shims are often missing from PATH in non-interactive ssh sessions.
node=${BOXERY_NODE:-}
conf=${BOXERY_CONF:-$HOME/.config/boxery}
if [ -z "$node" ] && [ -f "$conf/host.env" ]; then node=$(sed -n 's/^BOXERY_NODE=//p' "$conf/host.env" | tail -n 1); fi
if [ -z "$node" ] || [ ! -x "$node" ]; then
	node=$(command -v node) || { echo "boxery-host: node not found (need Node >= 22.13; run boxery-host init with it on PATH)" >&2; exit 1; }
fi
# version/upgrade load no host modules, so they work on any Node (and the upgrade replaces the code on disk).
case ${1:-} in version | upgrade) exec "$node" --disable-warning=ExperimentalWarning "$ROOT/host/boxery-upgrade.mjs" "$@" ;; esac
exec "$node" --disable-warning=ExperimentalWarning "$ROOT/host/boxery-host.mjs" "$@"
